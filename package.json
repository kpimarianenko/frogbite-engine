{
  "name": "frogbite-engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "lint": "eslint . --max-warnings=0 & stylelint \"**/*.css\"",
    "lint:fix": "eslint . --fix && prettier . --write && stylelint --fix \"**/*.css\"",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-eslint-comments": "3.2.0",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "17.0.6",
    "prettier": "3.8.3",
    "stylelint": "17.12.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.60.0",
    "vite": "8.0.12"
  }
}
